---
import PrimaryButton from "./ui/PrimaryButton.astro";
import SecondaryButton from "./ui/SecondaryButton.astro";
import OrderOnlineBtn from "./ui/OrderOnlineBtn.astro";
import Map from "./Map.astro";
import { cn } from "../utils/cn";
import { heroScrimAlpha } from "../utils/contrast";
import MediaToggleButton from "./ui/MediaToggleButton.astro";

const { content, section } = Astro.props;
// Darkening layer between the photo/video and the text of full-bleed heroes (see utils/contrast.ts)
const scrim = section?.sectionType === "imgBg" || section?.sectionType === "video" ? heroScrimAlpha(section, 0.5, section?.sectionType !== "video") : 0;
// Embedded background video: the src goes in data-src and utils/media-toggle.ts sets it unless the visitor prefers reduced motion
const bgIframeSrc =
  section?.bgVideoType === "vimeo"
    ? `https://player.vimeo.com/video/${section?.bgVideoId}?autoplay=1&loop=1&background=1`
    : section?.bgVideoType === "gjw"
      ? `https://www.ganjingworld.com/zh-CN/embed/${section?.bgVideoId}?autoplay=1&loop=1&controls=0&mute=1`
      : section?.bgVideoType === "youtube"
        ? `https://www.youtube.com/embed/${section?.bgVideoId}?controls=0&autoplay=1&loop=1&mute=1`
        : "";
const bgPoster = section?.bgVideoPoster || section?.bgImg;
function hexToRgb(hex:string) {
  const parsedHex = hex?.replace("#", "");
  
  const bigint = parseInt(parsedHex, 16);
  const r = (bigint >> 16) & 255;
  const g = (bigint >> 8) & 255;
  const b = bigint & 255;

  return `${r}, ${g}, ${b}`;
}
---

<section
  class={cn(
    "scroll-mt-100 sm:scroll-mt-150",
    section?.type === "feature"
      ? section?.noMarginTop
        ? "pt-0"
        : "pt-16 sm:pt-24 md:pt-32"
      : ""
  )}
  style={section?.type === "feature"
    ? `${section?.bgColor ? `background-color: ${section?.bgColor};` : ""}  ${section?.bgOpacity ? `opacity: ${section?.bgOpacity};` : ""}`
    : ""}
  id={section?.id || undefined}
>
  <div
    class={cn(
      "relative lg:overflow-hidden"
    )}
    style={`
      ${section?.sectionType === "imgBg" && section?.height ? `height: ${section?.height}vh;` : ""}
    `}
  >
    {
      section?.sectionType === "video" && section?.bgVideoId ? (
        <div
          class="hidden sm:block h-full overflow-hidden"
          style="padding:56.25% 0 0 0;position:relative;"
          data-media-wrap
        >
          {section?.bgVideoType === "local" ? (
            <video
              data-bg-video
              data-media
              data-src={`/${section?.bgVideoId}`}
              poster={
                section?.bgVideoPoster
                  ? `/${section?.bgVideoPoster}`
                  : section?.bgImg
                    ? `/${section?.bgImg}`
                    : undefined
              }
              class="local-bg-video absolute inset-0 -z-[5] h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="none"
            />
          ) : (
            <>
            <iframe
              id="bg-video"
              data-media
              data-src={bgIframeSrc}
              title={
                content?.seo?.metaTitle
                  ? content?.seo?.metaTitle
                  : content?.title
              }
              class="absolute inset-0 -z-10 h-full w-full object-cover"
              allow="accelerometer; autoplay;"
              allowfullscreen
            />
            {bgPoster ? (
              <img
                data-media-poster
                src={`/${bgPoster}`}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 -z-[5] h-full w-full object-cover"
                style="display:none"
                decoding="async"
              />
            ) : null}
            </>
          )}
          <div class="absolute inset-0 w-full h-full flex justify-center items-center">
            <div class="text-center max-w-2xl sm:max-w-3xl">
              <div
                class={cn(
                  "font-bold block mt-4 sm:p-4",
                  section?.isTextAlignCenter ? "text-center" : ""
                )}
                style={`
  color: ${section?.titleColor || "inherit"};
  background-color:rgba(${hexToRgb(section?.titleBgColor)}, ${section?.titleBgOpacity || 0})
`}
              >
                <h1 class="text-4xl sm:text-6xl">
                {section?.title.map((line: string, index: number) => (
                  <Fragment key={index}>{line}</Fragment><br/>
                ))}
                
                </h1>
{section?.description.map((info: string, index: number) => (
                  <Fragment key={index}>
                    <p
                      class={cn(
                        "mt-6 text-lg   max-w-3xl",
                        section?.isTextAlignCenter ? "text-center" : ""
                      )}
                      style={`color: ${section?.descriptionColor}`}
                    >
                      {info}
                    </p>
                  </Fragment>
                ))}
              
              </div>

              <div
                class={cn(
                  "mt-10 flex items-center justify-center gap-x-6 flex-col sm:flex-row gap-4",
                  section?.isTextAlignCenter ? "text-center" : ""
                )}
              >
                {section?.addOrderOnlineBtn ? (
                  <OrderOnlineBtn
                    content={content}
                    text={section?.orderOnlineBtnInsteadText || "Order Online"}
                    dataGlfCuid={content?.cuid}
                    dataGlfRuid={content?.ruid}
                  />
                ) : (
                  ""
                )}
                {section?.addTableReservationBtn && (
                  <OrderOnlineBtn
                    content={content}
                    text={
                      section?.tableReservationBtnInsteadText ||
                      "Table Reservation"
                    }
                    dataGlfCuid={content?.cuid}
                    dataGlfRuid={content?.ruid}
                    isReservation
                  />
                )}
                {section?.btn1Text ? (
                  <PrimaryButton
                    content={content}
                    text={section?.btn1Text}
                    href={section?.btn1Href}
                  />
                ) : (
                  ""
                )}
                {section?.btn2Text ? (
                  <SecondaryButton
                    content={content}
                    text={section?.btn2Text}
                    href={section?.btn2Href}
                  />
                ) : (
                  ""
                )}
              </div>
            </div>
          </div>
          {section?.bgVideoType === "local" || bgIframeSrc ? (
            <MediaToggleButton
              content={content}
              class={section?.bottomInfo ? "bottom-20 right-4" : "bottom-4 right-4"}
            />
          ) : null}
          <script src="https://player.vimeo.com/api/player.js" />
        </div>
      ) : (
        ""
      )
    }
    {
      section?.bgImg ||
      (section?.sectionType === "video" && section?.bgVideoPoster) ? (
        <img
          src={`/${section?.bgImg || section?.bgVideoPoster}`}
          alt=""
          aria-hidden="true"
          class={cn(
            "absolute inset-0 h-full w-full object-cover",
            section?.sectionType === "video" ? "-z-[5]" : "-z-10",
            `${section?.sectionType === "video" ? "sm:hidden" : ""}`,
            `${section?.mobileBgImg ? " hidden sm:block" : ""}`
          )}
          loading="eager"
          decoding="async"
          {...{ fetchpriority: "high" }}
        />
      ) : (
        ""
      )
    }
    {
      section?.mobileBgImg ? (
        <img
          src={`/${section?.mobileBgImg}`}
          alt=""
          aria-hidden="true"
          class={cn(
            "absolute inset-0 h-full w-full object-cover sm:hidden",
            section?.sectionType === "video" ? "-z-[5]" : "-z-10",
            `${section?.sectionType === "video" ? "sm:hidden" : ""}`
          )}
          loading="eager"
        />
      ) : (
        ""
      )
    }

    {
      section?.bgColor ? (
        <>
          <span
            class="absolute -z-10 w-full inset-0 top-0 left-0"
            style={`background-color:${section?.bgColor}; opacity: ${section?.bgOpacity}`}
          />
        </>
      ) : (
        ""
      )
    }
    {
      scrim > 0 ? (
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-[4]"
          style={`background-color: rgba(0, 0, 0, ${scrim});`}
        />
      ) : (
        ""
      )
    }
    {
      section?.bottomInfo ? (
        <span>
          <span
            class="absolute -z-10 w-full h-16 inset-x-0 bottom-0 left-0 text-white font-semibold flex justify-center items-center"
            style="background-color:#000000; opacity: 0.55"
          >
            {section?.bottomInfo}
          </span>
        </span>
      ) : (
        ""
      )
    }
    <div
      class={cn(
        "m-auto max-w-2xl md:max-w-7xl flex flex-col justify-center items-center",
        `${section?.sectionType === "video" ? "sm:hidden" : ""}`
      )}
      style={section?.sectionType === "video" && !section?.imgPosition
        ? `min-height: ${section?.height || 60}vh;`
        : ""}
    >
      {
        section?.sectionType === "imgBg" ||
        (section?.sectionType === "video" && !section?.imgPosition) ? (
          <div class="absolute inset-0 w-full h-full flex justify-center items-center">
            <div class="text-center max-w-2xl sm:max-w-3xl px-6">
              <div>
                <div
                  class={cn(
                    "font-bold block mt-4 sm:p-4",
                    section?.isTextAlignCenter ? "text-center" : ""
                  )}
                  style={`
  color: ${section?.titleColor || "inherit"};
  background-color:rgba(${hexToRgb(section?.titleBgColor)}, ${section?.titleBgOpacity || 0});

`}
                >
                  <h1 class="text-4xl sm:text-6xl leading-12">
                  {section?.title.map((line: string, index: number) => (
                    <Fragment key={index}>{line}</Fragment><br/>
                  ))}
                  
                  </h1>
{section?.description.map((info: string, index: number) => (
                    <Fragment key={index}>
                      <p
                        class={cn(
                          "mt-8 text-base font-semibold sm:text-2xl",
                          section?.isTextAlignCenter ? "text-center" : ""
                        )}
                        style={`color: ${section?.descriptionColor}`}
                      >
                        {info}
                      </p>
                    </Fragment>
                  ))}
                
                </div>

                <div class="mt-10 flex items-center justify-center gap-x-6 flex-col sm:flex-row gap-4">
                  {section?.addOrderOnlineBtn ? (
                    <OrderOnlineBtn
                      content={content}
                      text={
                        section?.orderOnlineBtnInsteadText || "Order Online"
                      }
                      dataGlfCuid={content?.cuid}
                      dataGlfRuid={content?.ruid}
                    />
                  ) : (
                    ""
                  )}
                  {section?.addTableReservationBtn && (
                    <OrderOnlineBtn
                      content={content}
                      text={
                        section?.tableReservationBtnInsteadText ||
                        "Table Reservation"
                      }
                      dataGlfCuid={content?.cuid}
                      dataGlfRuid={content?.ruid}
                      isReservation
                    />
                  )}
                  {section?.btn1Text ? (
                    <PrimaryButton
                      content={content}
                      text={section?.btn1Text}
                      href={section?.btn1Href}
                    />
                  ) : (
                    ""
                  )}
                  {section?.btn2Text ? (
                    <SecondaryButton
                      content={content}
                      text={section?.btn2Text}
                      href={section?.btn2Href}
                    />
                  ) : (
                    ""
                  )}
                </div>
              </div>
            </div>
          </div>
        ) : (
          ""
        )
      }
      {
        section?.sectionType === "imgWithText" ||
        (section?.sectionType === "video" && section?.imgPosition) ? (
          <div
            class={cn(
              "relative isolate mx-auto max-w-7xl px-6 w-full lg:grid lg:grid-cols-2 lg:content-center lg:gap-x-10 lg:px-8",
              section?.sectionType === "video" ? "block sm:hidden" : "",
              section?.bannerMarginTopMobile
                ? `mt-${section.bannerMarginTopMobile} mb-${section.bannerMarginTopMobile} sm:mt-0 sm:mb-0 sm:pt-0`
                : ""
            )}
            style={`${section?.type !== "hero" ? "" : "padding-top:56px"} `}
          >
            {section?.bannerImg ? (
              <div class="lg:flex-grow">
                <img
                  src={`/${section?.bannerImg}`}
                  class={cn(
                    "object-cover max-w-full drop-shadow-xl rounded-lg",
                    section?.imgRounded ? `rounded-${section?.imgRounded}` : "",
                    section?.extraStyleToTheImage
                      ? section?.extraStyleToTheImage
                      : "",
                    section.imgEffect === "hoverRotate"
                      ? "transform hover:rotate-45 transition duration-500 ease-in-out"
                      : ""
                  )}
                  alt={section?.bannerImgAlt ? String(section.bannerImgAlt) : ""}
                />
              </div>
            ) : (
              ""
            )}
            {section?.map ? (
              <Map content={content} section={section} isChildComponent />
            ) : (
              ""
            )}
            <div
              class={cn(
                "lg:flex lg:flex-col justify-center ",
                section?.imgPosition === "imgRight" ? "order-first" : "",
                section?.isTextAlignCenter ? "text-center sm:text-left" : ""
              )}
            >
              {section?.type === "hero" ? (
                <div>
                  <div
                    class={cn(
                      "mt-10 max-w-lg font-bold block sm:p-4",
                      section?.isTextAlignCenter
                        ? "text-center sm:text-left"
                        : ""
                    )}
                    style={`
  color: ${section?.titleColor || "inherit"};
  background-color:rgba(${hexToRgb(section?.titleBgColor)}, ${section?.titleBgOpacity || 0})
`}
                  >
                    <h1 class="text-4xl sm:text-6xl">
                    {section?.title.map((line: string, index: number) => (
                      <Fragment key={index}>{line}</Fragment><br/>
                    ))}
                    
                    </h1>
{section?.description.map((info: string, index: number) => (
                      <Fragment key={index}>
                        <p
                          class={cn(
                            "mt-6 text-lg leading-8",
                            section?.isTextAlignCenter
                              ? "text-center sm:text-left"
                              : ""
                          )}
                          style={`color:${section?.descriptionColor};`}
                        >
                          {info}
                        </p>
                      </Fragment>
                    ))}
                  
                  </div>

                  <div class="flex gap-4 my-8 flex-col sm:flex-row">
                    {section?.addOrderOnlineBtn ? (
                      <OrderOnlineBtn
                        content={content}
                        text={
                          section?.orderOnlineBtnInsteadText || "Order Online"
                        }
                        dataGlfCuid={content?.cuid}
                        dataGlfRuid={content?.ruid}
                      />
                    ) : (
                      ""
                    )}
                    {section?.addTableReservationBtn && (
                      <OrderOnlineBtn
                        content={content}
                        text={
                          section?.tableReservationBtnInsteadText ||
                          "Table Reservation"
                        }
                        dataGlfCuid={content?.cuid}
                        dataGlfRuid={content?.ruid}
                        isReservation
                      />
                    )}
                    {section?.btn1Text ? (
                      <PrimaryButton
                        content={content}
                        text={section?.btn1Text}
                        href={section?.btn1Href}
                      />
                    ) : (
                      ""
                    )}
                    {section?.btn2Text ? (
                      <SecondaryButton
                        content={content}
                        text={section?.btn2Text}
                        href={section?.btn2Href}
                      />
                    ) : (
                      ""
                    )}
                  </div>
                </div>
              ) : (
                ""
              )}

              {section?.type === "feature" ? (
                <div>
                  <h2
                    class={cn(
                      "mt-10 lg:mt-0 max-w-lg text-3xl font-bold  sm:text-4xl",
                      section?.isTextAlignCenter
                        ? "text-center sm:text-left"
                        : "text-left"
                    )}
                    style={`color:${section?.titleColor};background-color:${section?.titleBgColor};padding:10px`}
                  >
                    {section?.title.map((line: string, index: number) => (
                      <Fragment key={index}>
                        <span class="block leading-16">{line}</span>
                      </Fragment>
                    ))}
                  </h2>

                  {section?.description.map((info: string, index: number) => (
                    <Fragment key={index}>
                      <p
                        class={cn(
                          "mt-6 text-lg leading-8",
                          section?.isTextAlignCenter
                            ? "text-center sm:text-left"
                            : ""
                        )}
                        style={`color:${section?.descriptionColor};`}
                      >
                        {info}
                      </p>
                    </Fragment>
                  ))}
                  {section?.title2 ? (
                    <h3
                      class="mt-10 max-w-lg text-xl font-bold  sm:text-2xl"
                      style={`color:${section?.title2Color};`}
                    >
                      {section?.title2?.includes("<br/>")
                        ? section?.title2
                            .split("<br/>")
                            .map((line: string, index: number) => (
                              <Fragment key={index}>
                                <span style={{ display: "block" }}>{line}</span>
                              </Fragment>
                            ))
                        : section?.title2}
                    </h3>
                  ) : (
                    ""
                  )}
                  {section?.description2 ? (
                    <div
                      class="mt-6 text-lg "
                      style={`color:${section?.description2Color};`}
                    >
                      {section?.description2?.map(
                        (info: string, index: number) => (
                          <Fragment key={index}>
                            <p
                              class={cn(
                                "mt-6 text-lg leading-8",
                                section?.isTextAlignCenter ? "text-center" : ""
                              )}
                              style={`color:${section?.description2Color};`}
                            >
                              {info}
                            </p>
                          </Fragment>
                        )
                      )}
                    </div>
                  ) : (
                    ""
                  )}
                  <div class="flex my-8 flex-col sm:flex-row gap-4">
                    {section?.addOrderOnlineBtn ? (
                      <OrderOnlineBtn
                        content={content}
                        text={
                          section?.orderOnlineBtnInsteadText || "Order Online"
                        }
                        dataGlfCuid={content?.cuid}
                        dataGlfRuid={content?.ruid}
                      />
                    ) : (
                      ""
                    )}
                    {section?.addTableReservationBtn && (
                      <OrderOnlineBtn
                        content={content}
                        text={
                          section?.tableReservationBtnInsteadText ||
                          "Table Reservation"
                        }
                        dataGlfCuid={content?.cuid}
                        dataGlfRuid={content?.ruid}
                        isReservation
                      />
                    )}
                    {section?.btn1Text ? (
                      <PrimaryButton
                        content={content}
                        text={section?.btn1Text}
                        href={section?.btn1Href}
                      />
                    ) : (
                      ""
                    )}
                    {section?.btn2Text ? (
                      <SecondaryButton
                        content={content}
                        text={section?.btn2Text}
                        href={section?.btn2Href}
                      />
                    ) : (
                      ""
                    )}
                  </div>
                </div>
              ) : (
                ""
              )}
            </div>
          </div>
        ) : (
          ""
        )
      }
    </div>
  </div>
</section>
<script>
  // Background video start/pause (local video, YouTube, Vimeo, Gan Jing World), the pause button and
  // prefers-reduced-motion are handled in utils/media-toggle.ts, which runs when imported.
  import "../utils/media-toggle";
</script>
