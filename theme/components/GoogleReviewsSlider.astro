---
import { cn } from "../utils/cn";
import { pageLang, isChinese } from "../utils/lang";

type GoogleReview = {
  author: { name: string; imageUrl?: string | null };
  rating: number;
  body: string;
};

const { section } = Astro.props;
const zh = isChinese(pageLang(Astro.url.pathname, Astro.props.locale));
const label = {
  region: section?.ariaLabel ?? (zh ? "顧客評論" : "Customer reviews"),
  prev: zh ? "上一則評論" : "Previous reviews",
  next: zh ? "下一則評論" : "Next reviews",
  go: (n: number) => (zh ? `前往第 ${n} 則評論` : `Go to review ${n}`),
};

const getRandomColor = () => {
  const colors = [
    "bg-red-700",
    "bg-blue-700",
    "bg-green-700",
    "bg-yellow-700",
    "bg-purple-700",
    "bg-pink-700",
    "bg-orange-700",
    "bg-teal-700",
    "bg-indigo-700",
    "bg-lime-700",
    "bg-cyan-700",
    "bg-amber-700",
    "bg-rose-700",
    "bg-fuchsia-700",
    "bg-emerald-700",
    "bg-sky-700",
    "bg-violet-700",
    "bg-stone-700",
    "bg-gray-700",
    "bg-zinc-700",
  ];
  return colors[Math.floor(Math.random() * colors.length)];
};

const getInitial = (name: string) => {
  return name ? name.charAt(0).toUpperCase() : "?";
};
---

<section
  id={section?.id || undefined}
  class={cn(section?.noMarginTop ? "pt-0" : "pt-16 sm:pt-24 md:pt-32")}
>
  <div style={`background-color:${section?.bgColor}`}>
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl text-center">
          {
            section?.title?.map((line: string, index: number) => (
              <Fragment key={index}>
                <span class="block leading-16">{line}</span>
              </Fragment>
            ))
          }
        </h2>

        {
          section?.description?.map((info: string, index: number) => (
            <Fragment key={index}>
              <p class="mt-4 text-lg leading-8 text-gray-600 text-center">
                {info}
              </p>
            </Fragment>
          ))
        }
      </div>

      <!-- Slider Container -->
      <div class="mt-12 relative">
        <!-- Reviews Wrapper -->
        <div
          class="reviews-slider-wrapper overflow-x-auto"
          tabindex="0"
          role="region"
          aria-label={label.region}
          style={{
            scrollBehavior: "smooth",
            WebkitOverflowScrolling: "touch",
          }}
        >
          <div class="reviews-slider-track flex gap-6 pb-4">
            {
              section?.items?.map((review: GoogleReview) => (
                <div
                  class="reviews-slider-item flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] "
                >
                  <div class="h-full rounded-2xl bg-gray-50 p-6 sm:p-8 flex flex-col">
                    <!-- Star Rating -->
                    {review?.rating && (
                      <div
                        role="img"
                        aria-label={zh ? `5 顆星中的 ${review.rating} 顆` : `${review.rating} out of 5 stars`}
                        class="mb-4"
                      >
                        <div class="flex items-center gap-1">
                          {Array.from({ length: 5 }, (_, starIndex) => (
                            <svg
                              class={cn(
                                starIndex < review.rating
                                  ? "text-yellow-400"
                                  : "text-gray-300",
                                "size-5 shrink-0"
                              )}
                              aria-hidden="true"
                              xmlns="http://www.w3.org/2000/svg"
                              width="24"
                              height="24"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              class="icon icon-tabler icons-tabler-filled icon-tabler-star"
                            >
                              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                              <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" />
                            </svg>
                          ))}
                        </div>
                      </div>
                    )}

                    <!-- Review Text -->
                    {review?.body && (
                      <blockquote class="text-gray-900 text-base leading-6 mb-6 flex-grow">
                        <p>{`"${review.body}"`}</p>
                      </blockquote>
                    )}

                    <!-- Author Info -->
                    <div class="flex items-center gap-x-4 mt-auto pt-6 border-t border-gray-200">
                      {review?.author?.imageUrl ? (
                        <img
                          src={review.author.imageUrl}
                          alt={review.author.name}
                          class="size-12 rounded-full object-cover"
                        />
                      ) : (
                        <div
                          class={`size-12 rounded-full flex items-center justify-center ${getRandomColor()}`}
                        >
                          <span class="text-white text-lg font-bold">
                            {getInitial(review.author.name)}
                          </span>
                        </div>
                      )}

                      <div>
                        {review?.author?.name && (
                          <div class="font-semibold text-gray-900">
                            {review.author.name}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Navigation buttons beside the cards (large screens) -->
        <button
          type="button"
          class="reviews-slider-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-6 z-10 hidden lg:flex bg-white rounded-full p-2 shadow-md hover:shadow-lg transition-shadow items-center justify-center disabled:opacity-40"
          aria-label={label.prev}
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          class="reviews-slider-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-6 z-10 hidden lg:flex bg-white rounded-full p-2 shadow-md hover:shadow-lg transition-shadow items-center justify-center disabled:opacity-40"
          aria-label={label.next}
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Controls below the cards: arrows (small screens) and one dot per stop -->
      <div class="flex justify-center items-center gap-1 mt-8">
        <button
          type="button"
          class="reviews-slider-prev flex lg:hidden mr-2 bg-white rounded-full p-2 shadow-md hover:shadow-lg transition-shadow items-center justify-center disabled:opacity-40"
          aria-label={label.prev}
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        {
          section?.items?.map((_: unknown, index: number) => (
            <button
              type="button"
              class="reviews-slider-dot group w-6 h-6 flex items-center justify-center"
              data-slide={index}
              aria-label={label.go(index + 1)}
            >
              <span class="block w-2 h-2 rounded-full bg-gray-300 transition-all group-hover:bg-gray-600" />
            </button>
          ))
        }
        <button
          type="button"
          class="reviews-slider-next flex lg:hidden ml-2 bg-white rounded-full p-2 shadow-md hover:shadow-lg transition-shadow items-center justify-center disabled:opacity-40"
          aria-label={label.next}
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-slider-wrapper {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .reviews-slider-wrapper::-webkit-scrollbar {
    display: none;
  }

  .reviews-slider-item {
    scroll-snap-align: start;
  }
</style>

<script>
  function initReviewsSlider(wrapper: HTMLElement) {
    const section = wrapper.closest("section");
    const track = wrapper.querySelector<HTMLElement>(".reviews-slider-track");
    const items = Array.from(wrapper.querySelectorAll<HTMLElement>(".reviews-slider-item"));
    if (!section || !track || !items.length) return;

    const prevs = Array.from(section.querySelectorAll<HTMLButtonElement>(".reviews-slider-prev"));
    const nexts = Array.from(section.querySelectorAll<HTMLButtonElement>(".reviews-slider-next"));
    const dots = Array.from(section.querySelectorAll<HTMLButtonElement>(".reviews-slider-dot"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Measured every time, so rotating the phone or resizing the window never leaves stale numbers behind.
    const step = () => items[0].offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0);
    const perView = () => Math.max(1, Math.round(wrapper.clientWidth / step()));
    const maxIndex = () => Math.max(0, items.length - perView());
    const current = () => Math.min(maxIndex(), Math.max(0, Math.round(wrapper.scrollLeft / step())));
    const goTo = (index: number) =>
      wrapper.scrollTo({
        left: Math.min(maxIndex(), Math.max(0, index)) * step(),
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });

    const update = () => {
      const now = current();
      const last = maxIndex();
      dots.forEach((dot, index) => {
        dot.hidden = index > last;
        const mark = dot.firstElementChild as HTMLElement | null;
        const active = index === now;
        mark?.classList.toggle("bg-gray-600", active);
        mark?.classList.toggle("bg-gray-300", !active);
        if (active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      prevs.forEach((b) => (b.disabled = now <= 0));
      nexts.forEach((b) => (b.disabled = now >= last));
    };

    prevs.forEach((b) => b.addEventListener("click", () => goTo(current() - 1)));
    nexts.forEach((b) => b.addEventListener("click", () => goTo(current() + 1)));
    dots.forEach((dot, index) => dot.addEventListener("click", () => goTo(index)));
    wrapper.addEventListener("keydown", (event) => {
      if (event.target !== wrapper) return;
      if (event.key === "ArrowRight") { event.preventDefault(); goTo(current() + 1); }
      if (event.key === "ArrowLeft") { event.preventDefault(); goTo(current() - 1); }
    });

    let frame = 0;
    wrapper.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    }, { passive: true });
    if ("ResizeObserver" in window) new ResizeObserver(update).observe(wrapper);
    update();
  }

  document.querySelectorAll<HTMLElement>(".reviews-slider-wrapper").forEach(initReviewsSlider);
</script>
