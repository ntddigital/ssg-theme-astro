---
import { hasText } from "../utils/text";
import { cn } from "../utils/cn";
import { heroScrimAlpha } from "../utils/contrast";
const { section } = Astro.props;
// Only when text sits on a photo
// Background paths without a leading "/" or "http" would resolve relative to the page
const bgSrc = section?.bgImg
  ? /^(\/|https?:)/i.test(String(section.bgImg))
    ? String(section.bgImg)
    : `/${section.bgImg}`
  : "";
const scrim = section?.bgImg ? heroScrimAlpha(section) : 0;
---

<section
  class={cn(
    "relative",
    section?.noMarginTop
      ? ""
      : section?.bgImg || section?.bgColor
        ? "mt-16 sm:mt-24 md:mt-32"
        : "pt-16 sm:pt-24 md:pt-32",
    section?.bgImg || section?.bgColor ? "py-16 sm:py-20 lg:py-24" : ""
  )}
  id={section?.id || undefined}
>
  <div class="mx-auto max-w-4xl text-center px-6">
    {
      section?.bgImg ? (
        <img
          src={bgSrc}
          alt=""
          aria-hidden="true"
          class={cn(
            "absolute inset-0 -z-10 h-full w-full object-cover",
            `${section?.sectionType === "video" ? "sm:hidden" : ""}`
          )}
          loading="lazy"
        />
      ) : (
        ""
      )
    }
    {
      section?.bgColor ? (
        <span
          class="absolute -z-10 w-full inset-0 top-0 left-0"
          style={`background-color:${section?.bgColor}; opacity: ${section?.bgOpacity}`}
        />
      ) : (
        ""
      )
    }
    {
      scrim > 0 ? (
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-[4]"
          style={`background-color: rgba(0, 0, 0, ${scrim});`}
        />
      ) : (
        ""
      )
    }
    {hasText(section?.title) && (
<h2
      class="mb-4 text-3xl font-bold sm:text-4xl"
      style={`color:${section?.titleColor}`}
    >
      {
        section?.title?.map((line: string, index: number) => (
          <Fragment key={index}>
            <span class="block">{line}</span>
          </Fragment>
        ))
      }
    </h2>
)}

    {
      section?.description?.map((line: string, index: number) => (
        <Fragment key={index}>
          <p
            class="text-lg leading-8 mt-8"
            style={`color:${section?.descriptionColor};`}
          >
            {line}
          </p>
        </Fragment>
      ))
    }
  </div>
</section>
