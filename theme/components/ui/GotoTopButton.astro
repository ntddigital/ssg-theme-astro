---
import { pageLang, isChinese } from "../../utils/lang";
import { buttonTextColor } from "../../utils/contrast";

const { content } = Astro.props;
const zh = isChinese(pageLang(Astro.url.pathname, content?.seo?.locale));
// Disc in the brand colour, arrow in whichever of black/white is readable on it
const arrow = buttonTextColor(content?.primaryColor, content?.primaryColorScheme, content?.forceButtonTextColor);
---

<!-- go top button -->
<nav aria-label={zh ? "回到頂部" : "Back to top"}>
  <a
    href="#"
    class="fixed bottom-5 right-5 flex h-11 w-11 items-center justify-center rounded-full shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:bottom-10 sm:right-7"
    style={`background-color:${content?.primaryColor};`}
    aria-label={zh ? "回到頂端" : "Go to top"}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-7 w-7"
      viewBox="0 0 24 24"
      fill="none"
      stroke={arrow}
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 15l6-6 6 6"></path>
    </svg>
  </a>
</nav>
