---
import { cn } from "../../utils/cn";
import { buttonTextColor } from "../../utils/contrast";

const {
  content,
  text,
  backgroundColor,
  dataGlfCuid,
  dataGlfRuid,
  isReservation,
} = Astro.props;
const bg = backgroundColor ? backgroundColor : content?.primaryColor;
const fg = buttonTextColor(bg, content?.primaryColorScheme, content?.forceButtonTextColor);
---

<span
  class={cn(
    "cursor-pointer rounded-md px-3.5 py-2.5 text-lg font-semibold shadow-sm hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 whitespace-nowrap text-center",
  )}
  style={`background-color:${bg};color:${fg};`}
  data-glf-cuid={dataGlfCuid}
  data-glf-ruid={dataGlfRuid}
  {...isReservation ? { "data-glf-reservation": "true" } : {}}
>
  {text}
</span>
