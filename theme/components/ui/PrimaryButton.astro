---
import { cn } from "../../utils/cn";
import { buttonTextColor } from "../../utils/contrast";
import { pageLang, newTabHint } from "../../utils/lang";

const { content, text, href, backgroundColor } = Astro.props;
const bg = backgroundColor ? backgroundColor : content?.primaryColor;
const fg = buttonTextColor(bg, content?.primaryColorScheme, content?.forceButtonTextColor);
const hint = newTabHint(pageLang(Astro.url.pathname, content?.seo?.locale));
---

<a
  href={href}
  class={cn(
    "rounded-md px-3.5 py-2.5 text-lg font-semibold shadow-sm hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 whitespace-nowrap text-center",
  )}
  style={`background-color:${bg};color:${fg};`}
  target="_blank"
  rel="noopener noreferrer"
>
  {text}<span class="sr-only">{hint}</span>
</a>
