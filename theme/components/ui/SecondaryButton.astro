---
import { cn } from "../../utils/cn";
import { buttonTextColor } from "../../utils/contrast";
import { pageLang, isChinese, newTabHint } from "../../utils/lang";

const { content, text, href, backgroundColor } = Astro.props;
const bg = backgroundColor ? backgroundColor : content?.secondaryColor;
const fg = buttonTextColor(bg, content?.secondaryColorScheme, content?.forceButtonTextColor);
const lang = pageLang(Astro.url.pathname, content?.seo?.locale);
const hint = newTabHint(lang);
const phone = text?.replace("Tel:", "").trim();
const isTel = typeof href === "string" && href.startsWith("tel:"); // phone links open the dialer, not a new tab
---

{
  text?.includes("Tel:") ? (
    <div
      class={cn(
        "rounded-md px-3.5 py-2.5 text-lg font-semibold shadow-sm hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 whitespace-nowrap text-center",
      )}
      style={`background-color:${bg};color:${fg};`}
    >
      Tel:
      <a
        class="inline-block py-1"
        aria-label={`${isChinese(lang) ? "致電 " : "Call "}${phone}`}
        href={href}
      >
        {text?.replace("Tel:", "").trim()}
      </a>
    </div>
  ) : (
    <a
      href={href}
      class={cn(
        "rounded-md px-3.5 py-2.5 text-lg font-semibold shadow-sm hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 whitespace-nowrap text-center",
      )}
      style={`background-color:${bg};color:${fg};`}
      target={isTel ? undefined : "_blank"}
      rel={isTel ? undefined : "noopener noreferrer"}
    >
      {text}{isTel ? "" : <span class="sr-only">{hint}</span>}
    </a>
  )
}
